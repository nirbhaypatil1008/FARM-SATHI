# =================================================================
# KRISHI SAATHI AI - BACKEND ENVIRONMENT VARIABLES CONFIGURATION
# =================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to GitHub or any public repo!

# Application Environment (development, testing, production)
ENVIRONMENT=development
APP_NAME="Krishi Saathi AI"
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security & Authentication (Generate a strong 32+ character random secret)
# Example command to generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=krishi_saathi_hackathon_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# -----------------------------------------------------------------
# For Local Zero-Setup Development: Leave empty to automatically use SQLite: sqlite:///./krishi_saathi.db
# For Supabase / PostgreSQL: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./krishi_saathi.db

# AI & External APIs
# -----------------------------------------------------------------
# Google Gemini API Key (Get free key from https://aistudio.google.com/)
# If empty, the backend runs in Safe Rule-Based Offline Advisory mode.
GEMINI_API_KEY=

# Government of India Data / Agmarknet API Key (from https://data.gov.in/)
# If empty, high-quality curated Indian APMC mandi benchmarks are used.
DATA_GOV_IN_API_KEY=

# Bhashini Indian Language API (Configurable)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# CORS Allowed Origins (Comma-separated URLs allowed to call the backend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
